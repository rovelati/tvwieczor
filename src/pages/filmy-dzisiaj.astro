---
/**
 * Filmy dzisiaj w TV — TV Wieczór (tvwieczor.pl)
 * Wszystkie filmy fabularne w telewizji naziemnej z ocenami IMDb ⭐ i locandine TMDb.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import MoodPickerModal from '../components/MoodPickerModal.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInPoland, formatDatePL, formatTimePL, getPolandHour } from '../utils/timeSlots';
import { isMovie } from '../utils/programClassifier';
import { getFallbackImageForProgram, getCleanProgramImage } from '../utils/programImages';
import type { Channel, Program } from '../types';

const today = getTodayInPoland();
const dateLabel = formatDatePL(today);

interface FilmListing {
  program: Program;
  channel: Channel;
  slug: string;
}

let filmsTonight: FilmListing[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const channelMap = new Map<string, Channel>();
  for (const ch of channels) {
    channelMap.set(ch.id, ch);
  }

  for (const prog of allPrograms) {
    const slug = prog.channel_id ?? '';
    const ch = channelMap.get(slug);
    if (!ch) continue;

    const hour = getPolandHour(prog.start_time);
    const isEvening = hour >= 16 || hour <= 3;

    if (isEvening && isMovie(prog.category, prog.title, prog.description)) {
      filmsTonight.push({
        program: prog,
        channel: ch,
        slug,
      });
    }
  }

  // Sort chronologically by start time
  filmsTonight.sort((a, b) => new Date(a.program.start_time).getTime() - new Date(b.program.start_time).getTime());
} catch (err) {
  console.error('[filmy-dzisiaj.astro] Error fetching film listings:', err);
}

const pageTitle = "Filmy dzisiaj w TV | Dobre filmy w telewizji wieczorem z ocenami IMDb ⭐";
const pageDesc = "Sprawdź repertuar filmowy na dziś w TV. Wszystkie filmy fabularne, komedie i hity Hollywood w TVP, Polsat, TVN, TV Puls i Stopklatka z ocenami IMDb ⭐.";
const keywords = "filmy dzisiaj w tv, filmy w tv dzisiaj, co obejrzeć w tv film, program tv filmy, stopklatka program, filmy wieczorem, hity filmowe w tv";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Filmy dzisiaj w telewizji w Polsce",
  "inLanguage": "pl-PL",
  "spatialCoverage": {
    "@type": "Country",
    "name": "Polska",
    "identifier": "PL"
  },
  "itemListElement": filmsTonight.slice(0, 20).map((f, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Movie",
      "name": f.program.title,
      "description": f.program.description,
      "aggregateRating": f.program.imdb_rating ? {
        "@type": "AggregateRating",
        "ratingValue": String(f.program.imdb_rating),
        "bestRating": "10",
        "ratingCount": "1000"
      } : undefined
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero / Headline Bar -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold mb-3">
          <span>🍿 Seanse filmowe</span>
          <span>•</span>
          <span>{dateLabel}</span>
          <span>•</span>
          <span class="text-white font-bold">{filmsTonight.length} filmów w ramówce</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Filmy <span class="text-amber-400">dzisiaj w TV</span>
        </h1>
        <p class="text-base text-slate-400 mt-2 max-w-2xl">
          Wszystkie filmy w otwartych pasmach telewizyjnych z ocenami krytyków i widzów IMDb ⭐.
        </p>
      </div>

      <!-- Quick Filter Buttons -->
      <div class="flex items-center gap-2 flex-wrap">
        <button 
          type="button" 
          id="filter-all" 
          onclick="filterMovies('all')"
          class="filter-btn active px-4 py-2 rounded-xl bg-amber-400 text-slate-950 text-xs font-extrabold transition-colors cursor-pointer"
        >
          Wszystkie filmy
        </button>
        <button 
          type="button" 
          id="filter-top" 
          onclick="filterMovies('top')"
          class="filter-btn px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 text-slate-300 text-xs font-bold border border-slate-700 transition-colors cursor-pointer flex items-center gap-1.5"
        >
          <span>⭐</span>
          <span>Tylko hity (7.0+)</span>
        </button>
      </div>
    </div>

    <!-- Film Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="movies-grid">
      {filmsTonight.map(({ program, channel, slug }) => {
        const timeFormatted = formatTimePL(program.start_time);
        const cleanImg = getCleanProgramImage(program.image_url, program.title, program.category);
        const fallbackImg = getFallbackImageForProgram(program.title, program.category);
        const isTop = (program.imdb_rating || 0) >= 7.0;

        return (
          <div 
            class={`film-card bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-all duration-200 shadow-lg flex flex-col justify-between cursor-pointer group ${isTop ? 'is-top-rated' : ''}`}
            data-program-id={program.id}
            data-title={program.title}
            data-desc={program.description}
            data-category={program.category}
            data-start={program.start_time}
            data-end={program.end_time}
            data-imdb={program.imdb_rating}
            data-image={cleanImg}
            data-channel-slug={slug}
            data-channel-name={channel.name}
            data-channel-number={channel.number}
            data-channel-logo={channel.logo}
            data-vod-name={channel.vodPlatform}
            data-stream-url={channel.streamUrl}
            onclick="openProgramModal(this)"
          >
            <div>
              <!-- Channel Info Header -->
              <div class="flex items-center justify-between mb-3 pb-3 border-b border-slate-800/80">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-7 bg-slate-800 rounded-lg p-0.5 flex items-center justify-center border border-slate-700/50">
                    <img src={channel.logo} alt={channel.name} class="max-w-full max-h-full object-contain" loading="lazy" />
                  </div>
                  <div>
                    <span class="text-xs font-bold text-white group-hover:text-amber-300 transition-colors block leading-none">
                      {channel.name}
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono">
                      Kanał {channel.number}
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono font-bold text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20">
                    {timeFormatted}
                  </span>
                </div>
              </div>

              <!-- Main Film Content with Big Poster Preview -->
              <div class="flex items-start gap-4">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    {program.imdb_rating && (
                      <span class="text-xs font-extrabold text-amber-400 bg-amber-400/15 border border-amber-400/40 px-2 py-0.5 rounded flex items-center gap-1 shadow-sm">
                        <span>⭐</span>
                        <span>{program.imdb_rating} IMDb</span>
                      </span>
                    )}

                    {program.category && (
                      <span class="text-[10px] text-slate-400 bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700/50">
                        {program.category}
                      </span>
                    )}
                  </div>

                  <h2 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors line-clamp-2 mt-1">
                    {program.title}
                  </h2>

                  <p class="text-xs text-slate-400 line-clamp-3 mt-2 leading-relaxed">
                    {program.description || 'Sprawdź opis i szczegóły seansu w oknie programu.'}
                  </p>
                </div>

                <!-- Poster thumbnail -->
                {cleanImg && (
                  <div class="w-20 h-28 rounded-xl overflow-hidden bg-slate-800 flex-shrink-0 relative shadow-md flex items-center justify-center border border-slate-700/60">
                    <span class="absolute text-xl opacity-20 select-none">🍿</span>
                    <img 
                      src={cleanImg} 
                      alt={program.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform relative z-10" 
                      loading="lazy" 
                      referrerpolicy="no-referrer"
                      onerror={`if (!this.src.endsWith('${fallbackImg}')) { this.src = '${fallbackImg}'; } else { this.style.display = 'none'; }`}
                    />
                  </div>
                )}
              </div>
            </div>

            <!-- Footer Card Action -->
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-400">
                {channel.vodPlatform ? `Transmisja: ${channel.vodPlatform}` : 'Naziemna TV'}
              </span>
              <span class="text-amber-400 font-bold group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-0.5">
                Szczegóły seansu →
              </span>
            </div>
          </div>
        );
      })}
    </div>

  </main>

  <ProgramOverlay />
  <MoodPickerModal />
  <Footer />
</BaseLayout>

<script is:inline>
  function filterMovies(mode) {
    const cards = document.querySelectorAll('.film-card');
    const btnAll = document.getElementById('filter-all');
    const btnTop = document.getElementById('filter-top');

    if (mode === 'top') {
      cards.forEach(card => {
        if (card.classList.contains('is-top-rated')) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
      btnTop?.classList.add('bg-amber-400', 'text-slate-950', 'font-extrabold');
      btnTop?.classList.remove('bg-slate-850', 'text-slate-300');
      btnAll?.classList.remove('bg-amber-400', 'text-slate-950', 'font-extrabold');
      btnAll?.classList.add('bg-slate-850', 'text-slate-300');
    } else {
      cards.forEach(card => card.style.display = 'flex');
      btnAll?.classList.add('bg-amber-400', 'text-slate-950', 'font-extrabold');
      btnAll?.classList.remove('bg-slate-850', 'text-slate-300');
      btnTop?.classList.remove('bg-amber-400', 'text-slate-950', 'font-extrabold');
      btnTop?.classList.add('bg-slate-850', 'text-slate-300');
    }
  }
</script>
