---
/**
 * Teraz w TV — TV Wieczór (tvwieczor.pl)
 * Program TV na żywo z paskiem postępu dla 26 kanałów DVB-T2 w Polsce.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import MoodPickerModal from '../components/MoodPickerModal.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInPoland, formatDatePL, formatTimePL } from '../utils/timeSlots';
import { getFallbackImageForProgram, getCleanProgramImage } from '../utils/programImages';
import type { Channel, Program } from '../types';

const today = getTodayInPoland();
const dateLabel = formatDatePL(today);

interface LiveChannelItem {
  channel: Channel;
  slug: string;
  current?: Program;
  next?: Program;
}

let liveChannels: LiveChannelItem[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const now = new Date();
  const programsByChannel = new Map<string, Program[]>();

  for (const prog of allPrograms) {
    const key = prog.channel_id ?? '';
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = ch.id;
    const chProgs = (programsByChannel.get(slug) ?? []).sort(
      (a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime()
    );

    let currentProg: Program | undefined;
    let nextProg: Program | undefined;

    for (let i = 0; i < chProgs.length; i++) {
      const p = chProgs[i];
      const start = new Date(p.start_time);
      const end = new Date(p.end_time);

      if (now >= start && now < end) {
        currentProg = p;
        nextProg = chProgs[i + 1];
        break;
      } else if (now < start) {
        currentProg = p;
        nextProg = chProgs[i + 1];
        break;
      }
    }

    if (!currentProg && chProgs.length > 0) {
      currentProg = chProgs[chProgs.length - 1];
    }

    if (currentProg) {
      liveChannels.push({
        channel: ch,
        slug,
        current: currentProg,
        next: nextProg,
      });
    }
  }

  // Sort by LCN
  liveChannels.sort((a, b) => a.channel.number - b.channel.number);
} catch (err) {
  console.error('[teraz.astro] Error rendering Polish live page:', err);
}

const pageTitle = "Teraz w TV | Co leci teraz w telewizji — Program na żywo";
const pageDesc = "Sprawdź co leci teraz w TV na żywo. Aktualny program telewizyjny z paskiem postępu i minutami do końca dla TVP 1, TVP 2, Polsat, TVN i kanałów naziemnych.";
const keywords = "teraz w tv, co leci w tv teraz, program tv teraz, co dzisiaj w tv, telewizja na żywo, tvp 1 teraz, polsat teraz, tvn teraz";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Co leci teraz w TV w Polsce",
  "description": pageDesc,
  "inLanguage": "pl-PL",
  "itemListElement": liveChannels.slice(0, 15).map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "BroadcastEvent",
      "name": item.current?.title || item.channel.name,
      "startDate": item.current?.start_time,
      "endDate": item.current?.end_time,
      "publishedOn": {
        "@type": "BroadcastService",
        "name": item.channel.name,
        "broadcastChannelId": String(item.channel.number)
      }
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero / Headline Bar -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold mb-3">
          <span class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
          <span>Na żywo w TV</span>
          <span>•</span>
          <span>{dateLabel}</span>
          <span>•</span>
          <span class="text-amber-400 font-bold">26 stacji DVB-T2</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Co leci <span class="text-red-400">teraz w TV</span>
        </h1>
        <p class="text-base text-slate-400 mt-2 max-w-2xl">
          Programy nadawane w tej chwili wraz z paskiem postępu i czasem do końca audycji.
        </p>
      </div>

      <!-- View Switcher -->
      <div class="flex items-center gap-2">
        <a 
          href="/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-1.5"
        >
          <span>🌙</span>
          <span>Hit Wieczoru (20:00)</span>
        </a>
        <a 
          href="/filmy-dzisiaj/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-1.5"
        >
          <span>🍿</span>
          <span>Filmy dzisiaj</span>
        </a>
      </div>
    </div>

    <!-- Live Channel Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {liveChannels.map(({ channel, slug, current, next }) => {
        if (!current) return null;
        const curStart = formatTimePL(current.start_time);
        const curEnd = formatTimePL(current.end_time);
        const cleanImg = getCleanProgramImage(current.image_url, current.title, current.category);
        const fallbackImg = getFallbackImageForProgram(current.title, current.category);

        return (
          <div 
            class="live-card bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-all duration-200 shadow-lg flex flex-col justify-between"
            data-start-iso={current.start_time}
            data-end-iso={current.end_time}
          >
            <div>
              <!-- Channel Info Header -->
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800/80">
                <a href={`/${slug}/`} class="flex items-center gap-3 group">
                  <div class="w-10 h-8 bg-slate-800 rounded-lg p-1 flex items-center justify-center border border-slate-700/50">
                    <img src={channel.logo} alt={channel.name} class="max-w-full max-h-full object-contain" loading="lazy" />
                  </div>
                  <div>
                    <span class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors block">
                      {channel.name}
                    </span>
                    <span class="text-[10px] text-amber-400 font-mono font-semibold">
                      Kanał {channel.number}
                    </span>
                  </div>
                </a>

                {channel.vodPlatform && (
                  <span class="text-[10px] font-semibold text-slate-400 bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700/40">
                    {channel.vodPlatform}
                  </span>
                )}
              </div>

              <!-- Current Program Card -->
              <div 
                class="cursor-pointer group"
                data-program-id={current.id}
                data-title={current.title}
                data-desc={current.description}
                data-category={current.category}
                data-start={current.start_time}
                data-end={current.end_time}
                data-imdb={current.imdb_rating}
                data-image={cleanImg}
                data-channel-slug={slug}
                data-channel-name={channel.name}
                data-channel-number={channel.number}
                data-channel-logo={channel.logo}
                data-vod-name={channel.vodPlatform}
                data-stream-url={channel.streamUrl}
                onclick="openProgramModal(this)"
              >
                <div class="flex items-start gap-4">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      <span class="text-xs font-mono font-bold text-amber-400">
                        {curStart} - {curEnd}
                      </span>
                      {current.category && (
                        <span class="text-[10px] text-slate-400 bg-slate-800 px-1.5 py-0.2 rounded border border-slate-700/50">
                          {current.category}
                        </span>
                      )}
                      {current.imdb_rating && (
                        <span class="text-[10px] font-bold text-amber-400 bg-amber-400/10 px-1.5 py-0.2 rounded border border-amber-400/30">
                          ⭐ {current.imdb_rating}
                        </span>
                      )}
                    </div>

                    <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-amber-300 transition-colors line-clamp-1">
                      {current.title}
                    </h2>

                    <p class="text-xs text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                      {current.description || 'Aktualnie w emisji na żywo.'}
                    </p>
                  </div>

                  <!-- Thumbnail -->
                  {cleanImg && (
                    <div class="w-20 h-14 rounded-lg overflow-hidden bg-slate-800 flex-shrink-0 relative flex items-center justify-center">
                      <span class="absolute text-xs opacity-20 select-none">📺</span>
                      <img 
                        src={cleanImg} 
                        alt={current.title} 
                        class="w-full h-full object-cover relative z-10" 
                        loading="lazy" 
                        referrerpolicy="no-referrer"
                        onerror={`if (!this.src.endsWith('${fallbackImg}')) { this.src = '${fallbackImg}'; } else { this.style.display = 'none'; }`}
                      />
                    </div>
                  )}
                </div>

                <!-- Live Progress Bar -->
                <div class="mt-4 pt-3 border-t border-slate-800/80">
                  <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                    <span class="progress-label font-medium">Trwa emisja</span>
                    <span class="progress-pct font-mono font-bold text-amber-400">--%</span>
                  </div>
                  <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
                    <div class="progress-bar bg-gradient-to-r from-amber-400 to-rose-500 h-1.5 rounded-full transition-all duration-500" style="width: 50%"></div>
                  </div>
                </div>
              </div>

              <!-- Up Next Bar -->
              {next && (
                <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
                  <div class="truncate mr-2">
                    <span class="text-slate-500 font-bold uppercase text-[10px] mr-1">NASTĘPNIE:</span>
                    <span class="font-semibold text-slate-300">{next.title}</span>
                  </div>
                  <span class="font-mono text-amber-400 shrink-0">{formatTimePL(next.start_time)}</span>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

  </main>

  <ProgramOverlay />
  <MoodPickerModal />
  <Footer />
</BaseLayout>

<script is:inline>
  function updateProgressBars() {
    const now = new Date().getTime();
    document.querySelectorAll('.live-card').forEach(card => {
      const startIso = card.getAttribute('data-start-iso');
      const endIso = card.getAttribute('data-end-iso');
      if (!startIso || !endIso) return;

      const startTime = new Date(startIso).getTime();
      const endTime = new Date(endIso).getTime();
      const totalDuration = endTime - startTime;
      const elapsed = now - startTime;

      if (totalDuration > 0) {
        let percent = Math.min(100, Math.max(0, Math.round((elapsed / totalDuration) * 100)));
        const bar = card.querySelector('.progress-bar');
        const pctLabel = card.querySelector('.progress-pct');
        const label = card.querySelector('.progress-label');

        if (bar) bar.style.width = `${percent}%`;
        if (pctLabel) pctLabel.textContent = `${percent}%`;
        
        const remainingMin = Math.max(0, Math.round((endTime - now) / 60000));
        if (label) {
          if (remainingMin > 0) {
            label.textContent = `Do końca: ${remainingMin} min`;
          } else {
            label.textContent = 'Koniec programu';
          }
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', updateProgressBars);
  setInterval(updateProgressBars, 30000);
</script>
