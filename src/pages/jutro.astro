---
/**
 * Program TV na jutro — TV Wieczór (tvwieczor.pl)
 * Ramówka wieczorna na jutro dla bezpłatnych kanałów DVB-T2 w Polsce.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import MoodPickerModal from '../components/MoodPickerModal.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTomorrowInPoland, formatDatePL, getPolandHour } from '../utils/timeSlots';
import type { Channel, Program } from '../types';

const tomorrow = getTomorrowInPoland();
const dateLabel = formatDatePL(tomorrow);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(tomorrow),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = prog.channel_id ?? '';
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const allChPrograms = programsByChannel.get(ch.id) ?? [];
    if (allChPrograms.length === 0) continue;

    // Filter Evening window (from 19:30 onwards through 02:00)
    const eveningPrograms = allChPrograms
      .filter((p) => {
        const hour = getPolandHour(p.start_time);
        return hour >= 19 || hour <= 2;
      })
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    if (eveningPrograms.length > 0) {
      channelsWithPrograms.push({ ...ch, programs: eveningPrograms, slug: ch.id });
    }
  }

  channelsWithPrograms.sort((a, b) => a.number - b.number);
} catch (err) {
  console.error('[jutro.astro] Error rendering tomorrow page:', err);
}

const pageTitle = `Program TV na jutro (${dateLabel}) | TV Wieczór`;
const pageDesc = `Zobacz program telewizyjny na jutro (${dateLabel}). Sprawdź co będzie w TVP 1, TVP 2, Polsacie i TVN jutro wieczorem z ocenami IMDb ⭐.`;
const keywords = "program tv na jutro, program telewizyjny jutro, co jutro w tv, program tv jutro wieczór, co obejrzeć jutro w tv";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Program TV na jutro (${dateLabel})`,
  "description": pageDesc,
  "inLanguage": "pl-PL",
  "itemListElement": channelsWithPrograms.slice(0, 15).map((ch, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "BroadcastService",
      "name": ch.name,
      "broadcastChannelId": String(ch.number),
      "url": `https://tvwieczor.pl/${ch.slug}/`
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero / Headline Bar -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold mb-3">
          <span>📅 Plan na jutro</span>
          <span>•</span>
          <span>{dateLabel}</span>
          <span>•</span>
          <span class="text-amber-400 font-bold">Wieczór o 20:00</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Program TV na <span class="text-blue-400">jutro</span>
        </h1>
        <p class="text-base text-slate-400 mt-2 max-w-2xl">
          Zaplanuj swój jutrzejszy wieczór przed telewizorem. Pełna ramówka dla wszystkich polskich stacji naziemnych.
        </p>
      </div>

      <!-- Quick Nav -->
      <div class="flex items-center gap-2">
        <a 
          href="/" 
          class="px-4 py-2 rounded-xl bg-amber-400 text-slate-950 text-xs font-extrabold transition-colors flex items-center gap-1.5"
        >
          <span>🌙</span>
          <span>Wróć do: Dziś</span>
        </a>
      </div>
    </div>

    <!-- Tomorrow Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {channelsWithPrograms.map(ch => (
        <ChannelCard 
          channel={ch} 
          programs={ch.programs} 
          slug={ch.slug} 
        />
      ))}
    </div>

  </main>

  <ProgramOverlay />
  <MoodPickerModal />
  <Footer />
</BaseLayout>
