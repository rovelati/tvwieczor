---
/**
 * BaseLayout for tvwieczor.pl
 * Polska Guida TV — Naziemna Telewizja Cyfrowa DVB-T2
 */
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  keywords?: string;
  author?: string;
  publisher?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  keywords = "program tv, program tv na dziś, co dzisiaj w tv, program tv wieczór, filmy dzisiaj w tv, seriale w tv, sport w tv, tvp 1 program, polsat program, tvn program, naziemna telewizja cyfrowa dvb-t2",
  author = "TV Wieczór",
  publisher = "TV Wieczór",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://tvwieczor.pl';
const ogImageUrl = `${siteUrl}/icon-512.png`;

import '../styles/global.css';
---

<!doctype html>
<html lang="pl-PL" class="bg-slate-950 text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="author" content={author} />
    <meta name="publisher" content={publisher} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl-PL" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta http-equiv="content-language" content="pl-PL" />

    <!-- Microsoft Edge, Bing & IndexNow Verification -->
    <meta name="indexnow:key" content="4f25c5dc3491468f8459b92c21bb3ac1" />

    <!-- Poland Regional & Geo Targeting -->
    <meta name="application-name" content="TV Wieczór" />
    <meta name="theme-color" content="#020617" />
    <meta name="geo.region" content="PL" />
    <meta name="geo.country" content="Polska" />
    <meta name="geo.placename" content="Polska (Warszawa, Kraków, Wrocław, Poznań, Gdańsk, Łódź, Katowice)" />
    <meta name="geo.position" content="52.2297;21.0122" />
    <meta name="ICBM" content="52.2297, 21.0122" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="TV Wieczór" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:country_name" content="Polska" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Schema.org JSON-LD Structured Data -->
    {jsonLd && (
      Array.isArray(jsonLd) ? (
        jsonLd.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-amber-400 selection:text-slate-950">
    <slot />
  </body>
</html>
