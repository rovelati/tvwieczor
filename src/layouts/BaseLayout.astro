---
/**
 * BaseLayout for tvwieczor.pl
 * Polska Guida TV — Naziemna Telewizja Cyfrowa DVB-T2
 */
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  keywords?: string;
  author?: string;
  publisher?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  keywords = "program tv, program tv na dziś, co dzisiaj w tv, program tv wieczór, filmy dzisiaj w tv, seriale w tv, sport w tv, tvp 1 program, polsat program, tvn program, naziemna telewizja cyfrowa dvb-t2",
  author = "TV Wieczór",
  publisher = "TV Wieczór",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://tvwieczor.pl';
const ogImageUrl = `${siteUrl}/icon-512.png`;

import '../styles/global.css';
---

<!doctype html>
<html lang="pl-PL" class="bg-slate-950 text-slate-100 antialiased">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-B7FZMLJYHH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-B7FZMLJYHH');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="author" content={author} />
    <meta name="publisher" content={publisher} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl-PL" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta http-equiv="content-language" content="pl-PL" />

    <!-- Microsoft Edge, Bing & IndexNow Verification -->
    <meta name="indexnow:key" content="4f25c5dc3491468f8459b92c21bb3ac1" />

    <!-- Poland Regional & Geo Targeting -->
    <meta name="application-name" content="TV Wieczór" />
    <meta name="theme-color" content="#020617" />
    <meta name="geo.region" content="PL" />
    <meta name="geo.country" content="Polska" />
    <meta name="geo.placename" content="Polska (Warszawa, Kraków, Wrocław, Poznań, Gdańsk, Łódź, Katowice)" />
    <meta name="geo.position" content="52.2297;21.0122" />
    <meta name="ICBM" content="52.2297, 21.0122" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="TV Wieczór" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:country_name" content="Polska" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Google Consent Mode v2 (Deny by default) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
    </script>

    <!-- UniConsent CMP (Consent Management Platform IAB TCF 2.2 / Google Consent Mode v2) -->
    <link rel="dns-prefetch" href="https://cmp.uniconsent.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <script is:inline src="https://cmp.uniconsent.com/v2/stub.min.js"></script>
    <script is:inline src="https://cmp.uniconsent.com/v2/stubgcm.min.js"></script>

    <!-- Personalizacja Brand i Konfiguracja CMP TV Wieczór -->
    <script is:inline>
      window.__unic_config_v2 = {
        company: 'TVWieczor.pl',
        site_name: 'TV Wieczór',
        brand: 'TVWieczor.pl',
        country: 'PL',
        publisherCountryCode: 'PL',
        lang: 'pl',
        unic_company: 'TVWieczor.pl',
        unic_logo: '',
        unic_policy_url: 'https://tvwieczor.pl/polityka-prywatnosci/',
        unic_language: 'PL',
        unic_barmode: 0
      };

      (function() {
        const _origFetch = window.fetch;
        if (_origFetch) {
          window.fetch = function(url, opts) {
            try {
              const urlStr = typeof url === 'string' ? url : (url && url.url ? url.url : '');
              if (urlStr.includes('uniconsent.com') && (urlStr.includes('/config') || urlStr.includes('/geo'))) {
                return _origFetch.apply(this, arguments).then(function(res) {
                  return res.clone().text().then(function(txt) {
                    try {
                      let data = JSON.parse(txt);
                      data.company = 'TVWieczor.pl';
                      data.brand = 'TV Wieczór';
                      data.site_name = 'TV Wieczór';
                      data.country = 'PL';
                      data.lang = 'pl';
                      if (data.config) {
                        data.config.company = 'TVWieczor.pl';
                        data.config.brand = 'TV Wieczór';
                        data.config.country = 'PL';
                        data.config.lang = 'pl';
                      }
                      return new Response(JSON.stringify(data), {
                        status: res.status,
                        statusText: res.statusText,
                        headers: res.headers
                      });
                    } catch(e) {
                      return res;
                    }
                  });
                });
              }
            } catch(e) {}
            return _origFetch.apply(this, arguments);
          };
        }
      })();
    </script>
    <script async src="https://cmp.uniconsent.com/v2/e538d9903a/cmp.js"></script>

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2168172914069272"
      crossorigin="anonymous"
    ></script>

    <style is:inline>
      #unicmp, .unic, .unic-bar, .unic-modal {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      }
      .unic .unic-bar, .unic-bar {
        border-top: 3px solid #f59e0b !important;
        background: #020617 !important;
        color: #f8fafc !important;
        box-shadow: 0 -12px 30px rgba(0, 0, 0, 0.4) !important;
      }
      .unic .unic-bar-sheet__title,
      .unic .uniclogo,
      .unic strong:first-child {
        color: #fbbf24 !important;
        font-weight: 800 !important;
      }
      .unic button.unic-bar-dark__btn--primary,
      .unic .unic-bar-sheet__btn:last-child,
      .unic button[class*="primary"],
      .unic-actions button:last-child,
      .unic-bar button:last-child,
      #unicmp button.primary {
        background: #f59e0b !important;
        color: #020617 !important;
        border: none !important;
        border-radius: 8px !important;
        font-weight: 800 !important;
      }
    </style>

    <!-- Schema.org JSON-LD Structured Data -->
    {jsonLd && (
      Array.isArray(jsonLd) ? (
        jsonLd.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-amber-400 selection:text-slate-950">
    <slot />
  </body>
</html>
